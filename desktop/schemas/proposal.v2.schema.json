{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blackhole/proposal.v2.schema.json",
  "title": "Blackhole 로컬 작업기 제안 JSON v2",
  "description": "음성·글·문서·이미지 하나를 로컬 모델로 분석한 결과. 날짜·시각은 코드가 referenceTime 기준으로 계산한다. 23열 Items 계약과 같은 kind/area 값을 쓰고, NOTE(기억할 정보)는 제안 단계에만 있다. v2: 하위 할 일(subtasks), 알림 시각 목록(reminders), 여러 날 기간(kind PERIOD: startAt=첫날 00:00, endAt=마지막 다음 날 00:00).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "referenceTime",
    "engine",
    "sourceText",
    "summary",
    "items",
    "needsReview",
    "reviewReasons",
    "timings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "format",
        "sha256",
        "bytes"
      ],
      "properties": {
        "type": {
          "enum": [
            "audio",
            "text",
            "document",
            "image"
          ]
        },
        "format": {
          "type": "string",
          "description": "소문자 확장자. 파일 이름·경로는 담지 않는다."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "referenceTime": {
      "type": "string",
      "format": "date-time"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reader",
        "llmModel",
        "promptVersion",
        "workerVersion"
      ],
      "properties": {
        "id": {
          "enum": [
            "A",
            "B"
          ],
          "description": "A: 글자로 먼저 바꾼 뒤 Gemma 텍스트 모델. B: Gemma가 음성·이미지를 직접 읽음."
        },
        "reader": {
          "type": "string",
          "description": "whisper 모델 또는 kordoc 버전. 글 입력·B 엔진은 빈 문자열."
        },
        "llmModel": {
          "type": "string"
        },
        "promptVersion": {
          "type": "string"
        },
        "workerVersion": {
          "type": "string"
        }
      }
    },
    "sourceText": {
      "type": "string",
      "description": "받아 적은 문장, 입력한 글, 문서·이미지에서 읽은 글."
    },
    "summary": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "needsReview": {
      "type": "boolean"
    },
    "reviewReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readMs",
        "llmMs",
        "totalMs"
      ],
      "properties": {
        "readMs": {
          "type": "integer",
          "minimum": 0
        },
        "llmMs": {
          "type": "integer",
          "minimum": 0
        },
        "totalMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "instantOrEmpty": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "area",
        "title",
        "details",
        "startAt",
        "endAt",
        "reminderAt",
        "reminders",
        "subtasks",
        "evidence",
        "confidence",
        "needsReview",
        "reviewReasons"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCHEDULE",
            "TODO",
            "NOTE",
            "PERIOD"
          ]
        },
        "area": {
          "enum": [
            "PERSONAL",
            "SCHOOL"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "details": {
          "type": "string"
        },
        "startAt": {
          "$ref": "#/$defs/instantOrEmpty"
        },
        "endAt": {
          "$ref": "#/$defs/instantOrEmpty"
        },
        "reminderAt": {
          "$ref": "#/$defs/instantOrEmpty"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sentence",
            "dateText",
            "timeText",
            "endDateText",
            "reminderText"
          ],
          "properties": {
            "sentence": {
              "type": "string"
            },
            "dateText": {
              "type": "string"
            },
            "timeText": {
              "type": "string"
            },
            "endDateText": {
              "type": "string"
            },
            "reminderText": {
              "type": "string"
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needsReview": {
          "type": "boolean"
        },
        "reviewReasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reminders": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date-time"
          },
          "description": "알림 시각들(이른 순). reminderAt은 첫 번째와 같다."
        },
        "subtasks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "할 일 아래 하위 할 일(원문 말 그대로)."
        },
        "suggestedSubtasks": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "원문에 없지만 모델이 제안한 단계(「AI 제안」, 최대 5개). 없으면 빠진다."
        }
      }
    }
  }
}
