{
  "name": "blackhole-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-tool.mjs vite",
    "build": "tsc --noEmit && node scripts/run-tool.mjs vite build",
    "test": "node scripts/run-tool.mjs vitest run",
    "test:watch": "node scripts/run-tool.mjs vitest",
    "acceptance": "node scripts/check.mjs",
    "tauri": "tauri",
    "build:phone": "tsc --noEmit && node scripts/run-tool.mjs vite build --config vite.phone.config.mjs",
    "layout": "node scripts/layout-check.mjs"
  },
  "dependencies": {
    "@fontsource/nanum-gothic": "5.3.0",
    "@fontsource/nanum-myeongjo": "5.3.0",
    "@fullcalendar/core": "6.1.19",
    "@fullcalendar/daygrid": "6.1.19",
    "@fullcalendar/interaction": "6.1.19",
    "@fullcalendar/timegrid": "6.1.19",
    "@tauri-apps/api": "~2.12.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "22.19.1",
    "esbuild-wasm": "^0.25.12",
    "jsdom": "^26.1.0",
    "rollup": "npm:@rollup/wasm-node@^4.52.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
