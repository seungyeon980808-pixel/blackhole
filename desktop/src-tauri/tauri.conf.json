{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blackhole",
  "version": "0.1.0",
  "identifier": "com.malhaedwo.blackhole.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "블랙홀",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active"
        },
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; media-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "블랙홀: 던져 두면 정리되는 개인 일정 달력",
    "longDescription": "문장·음성·사진·문서를 넣으면 규칙 초안과 Claude API로 일정·할 일·기간·기억을 정리하는 달력입니다. 달력은 이 컴퓨터에 저장하고 구글 캘린더에는 쓰지 않습니다.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "files": {
        "Resources/ko.lproj/InfoPlist.strings": "./ko.lproj/InfoPlist.strings"
      }
    }
  }
}
