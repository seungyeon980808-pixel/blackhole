# 휴대폰 APK 빌드용 운영 값 (예시). 이 파일을 ~/.config/blackhole/private.env 로 복사해 채우고, 권한은 600으로.
# 저장소에는 절대 넣지 마세요. build.sh가 빌드용 사본에만 넣습니다.
BLACKHOLE_OAUTH_CLIENT_PREFIX=123456789012-abcdefghijklmnop   # Google OAuth 클라이언트 ID에서 .apps.googleusercontent.com 앞부분
BLACKHOLE_ALLOWED_EMAIL=you@example.com                         # 이 앱에 로그인할 수 있는 구글 계정(하나)
BLACKHOLE_SPREADSHEET_ID=YOUR_SHEET_ID                          # 동기화에 쓸 구글 시트 ID
BLACKHOLE_PRIVACY_URL=https://example.com/blackhole/privacy     # 개인정보처리방침 주소
